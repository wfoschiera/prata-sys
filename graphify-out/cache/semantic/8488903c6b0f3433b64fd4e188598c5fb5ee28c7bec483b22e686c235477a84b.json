{"nodes": [{"id": "gstack_architecture_architecture_doc", "label": "gstack Architecture Document", "file_type": "document", "source_file": ".claude/skills/gstack/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "gstack_architecture_browse_daemon", "label": "Browse Daemon Model (long-lived Chromium)", "file_type": "concept", "source_file": ".claude/skills/gstack/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AI agents interacting with a browser need sub-second latency and persistent state; per-command browser cold-starts cost 3-5 seconds per tool call and lose cookies, tabs, and login sessions between commands."}, {"id": "gstack_architecture_bun_choice", "label": "Bun Runtime Choice", "file_type": "concept", "source_file": ".claude/skills/gstack/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compiled binaries (~58MB single executable, no node_modules at runtime), native SQLite for cookie DB decryption, native TypeScript execution, and built-in Bun.serve HTTP server. The real bottleneck is always Chromium, not the CLI."}, {"id": "gstack_architecture_state_file", "label": ".gstack/browse.json State File", "file_type": "concept", "source_file": ".claude/skills/gstack/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "gstack_architecture_bearer_token_auth", "label": "Bearer Token Auth (localhost-only)", "file_type": "concept", "source_file": ".claude/skills/gstack/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "gstack_architecture_ref_system", "label": "@ref Element Addressing System (@e/@c refs)", "file_type": "concept", "source_file": ".claude/skills/gstack/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Playwright Locators are external to the DOM, avoiding injected data-ref attributes which break under CSP, React/Vue hydration reconciliation, and shadow DOM. Refs cleared on navigation by design: stale refs should fail loudly rather than click the wrong element."}, {"id": "gstack_architecture_ring_buffer_logging", "label": "Circular Ring Buffer Logging (console/network/dialog)", "file_type": "concept", "source_file": ".claude/skills/gstack/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "gstack_architecture_skill_template_system", "label": "SKILL.md Template System (.tmpl + placeholders)", "file_type": "concept", "source_file": ".claude/skills/gstack/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hand-maintained docs always drift from code; generating {{COMMAND_REFERENCE}}/{{SNAPSHOT_FLAGS}} from source metadata makes nonexistent commands unrepresentable. Committed (not runtime-generated) because Claude reads SKILL.md at load time with no build step, CI can validate freshness, and git blame works."}, {"id": "gstack_architecture_command_dispatch", "label": "READ/WRITE/META Command Dispatch", "file_type": "concept", "source_file": ".claude/skills/gstack/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "gstack_architecture_crash_recovery", "label": "Crash Recovery (exit-and-restart)", "file_type": "concept", "source_file": ".claude/skills/gstack/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No self-healing: when Chromium crashes the server exits immediately and the CLI starts a fresh one on next command \u2014 simpler and more reliable than reconnecting to a half-dead browser process."}], "edges": [{"source": "gstack_architecture_architecture_doc", "target": "gstack_architecture_browse_daemon", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/gstack/ARCHITECTURE.md", "source_location": "The daemon model", "weight": 1.0}, {"source": "gstack_architecture_architecture_doc", "target": "gstack_architecture_bun_choice", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/gstack/ARCHITECTURE.md", "source_location": "Why Bun", "weight": 1.0}, {"source": "gstack_architecture_browse_daemon", "target": "gstack_architecture_state_file", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/gstack/ARCHITECTURE.md", "source_location": "State file", "weight": 1.0}, {"source": "gstack_architecture_state_file", "target": "gstack_architecture_bearer_token_auth", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/gstack/ARCHITECTURE.md", "source_location": "Bearer token auth: token written to state file mode 0o600", "weight": 1.0}, {"source": "gstack_architecture_architecture_doc", "target": "gstack_architecture_ref_system", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/gstack/ARCHITECTURE.md", "source_location": "The ref system", "weight": 1.0}, {"source": "gstack_architecture_ref_system", "target": "gstack_browser_playwright", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/gstack/ARCHITECTURE.md", "source_location": "How it works: builds Playwright Locators via getByRole", "weight": 1.0}, {"source": "gstack_architecture_architecture_doc", "target": "gstack_architecture_ring_buffer_logging", "relation": "references", "confide